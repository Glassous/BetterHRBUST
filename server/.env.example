# BetterHRBUST 服务端配置示例
# 复制为 server/.env（本地开发）或作为容器环境变量注入。
# 注意：本文件不包含也不需要任何学生信息相关配置。
#
# 这是服务端配置的唯一来源：本地开发时由 config.Load() 直接读取，
# 容器部署时由 docker-compose.yml 通过 env_file 注入；
# 仅 MONGO_URI / REDIS_ADDR / PORT / TRUSTED_PROXIES 会在容器内被 compose 覆盖为容器内网值。

# HTTP 监听端口
PORT=9191

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=betterhrbust

# Redis（仅用于限流计数；留空则自动关闭限流）
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
RATE_LIMIT_ENABLED=true

# 管理端 JWT：生产环境务必替换为足够长的随机串，例如
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=please-change-this-to-a-long-random-secret
JWT_TTL_HOURS=12

# 允许跨域访问的来源（admin 端独立部署时需要），多个用英文逗号分隔；
# 桌面端内置本地服务的回环源 http://127.0.0.1:1950-1959 已内置放行，无需配置
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# 可信反向代理网段：仅在服务端前面挂了 nginx 等代理时配置，
# 配好后限流才会按 X-Forwarded-For 中的真实来源地址统计（否则全部请求会被
# 记成代理自身的地址，导致限流误伤）；留空表示不信任任何代理头。
# 本机 nginx 反代填 127.0.0.1/32，容器部署填 Docker 网段（如 172.16.0.0/12）。
TRUSTED_PROXIES=

# 反馈列表单页上限
MAX_PAGE_SIZE=100

# ---------------- 管理端「回复邮件」（SMTP） ----------------
# SMTP_HOST 与 SMTP_FROM 需同时填写；任一为空时回复功能自动降级为不可用，
# 管理端会提示「邮件服务未配置」，其余功能不受影响。
# 常用组合：QQ/163 邮箱 smtp.qq.com:465（隐式 TLS）；企业邮 smtp.exmail.qq.com:587（STARTTLS）。
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# 发件邮箱地址，必须与 SMTP 账号允许的发件人一致，否则会被服务端拒收
SMTP_FROM=
# 发件人显示名前缀，最终展示为「前缀·管理员昵称」
SMTP_FROM_NAME=BetterHRBUST
# 465 端口请设为 true（隐式 TLS）；587 端口保持 false（自动 STARTTLS 升级）
# 留空时按端口自动判断：465 视为 true，其余为 false
SMTP_USE_TLS=

# 管理端快捷回复文案（可选）：多条用 || 分隔，每条写作「按钮文案::正文」，
# 省略 :: 时按钮文案自动取正文前 10 个字；留空使用内置的 4 条默认文案。
REPLY_TEMPLATES=

# ---------------- 「收到新反馈」提醒邮件 ----------------
# 每收到一条新的意见反馈，就向此邮箱发送一封提醒邮件，
# 正文包含反馈内容、联系方式、署名与提交时间，便于第一时间处理。
# 收件地址留空表示不发送提醒；发信复用上面的 SMTP 配置（SMTP 未配置时提醒同样不可用）。
# 团队协作可填写群组邮箱地址；此处只接受一个邮箱，不支持逗号分隔的多个地址。
FEEDBACK_NOTIFY_EMAIL=
# 设为 false 可在保留收件配置的前提下临时关闭提醒
FEEDBACK_NOTIFY_ENABLED=true
