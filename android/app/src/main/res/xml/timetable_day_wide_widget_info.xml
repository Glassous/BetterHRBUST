<?xml version="1.0" encoding="utf-8"?>
<!--
  日视图课表小部件（宽版）：桌面占位 4 列 × 4 行（280dp × 280dp），固定尺寸、不可缩放。
  minWidth / minHeight 按 vivo 原子组件 4×4 规范取值（建议 280dp，范围 240–320dp）。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_day_wide_description"
    android:initialLayout="@layout/widget_loading"
    android:minHeight="280dp"
    android:minWidth="280dp"
    android:previewImage="@drawable/widget_thumbnail_day_wide"
    android:previewLayout="@layout/widget_preview_day_wide"
    android:resizeMode="none"
    android:targetCellHeight="4"
    android:targetCellWidth="4"
    android:updatePeriodMillis="43200000"
    android:widgetCategory="home_screen"
    tools:targetApi="s" />
