<?xml version="1.0" encoding="utf-8"?>
<!--
  日视图（宽版）小部件的选择器预览图（API 31+ 由 previewLayout 渲染，低版本回退 previewImage）。
  仅作示意：固定文案与固定配色，不参与真实渲染。

  注意：该布局由桌面端以小部件白名单充气器加载，只能使用允许的控件
  （LinearLayout / FrameLayout / TextView 等）；`android.view.View`、`android.widget.Space`
  均不在白名单内，色块与空白占位一律使用空的 `TextView`。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_surface"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 顶部：今天 + 教学周 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="今天 · 周三"
            android:textColor="#172033"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="第 3 周"
            android:textColor="#56647B"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- 内容面板：与「双日课表」的面板同款（18dp 圆角 + 中性底色，不对今天做高亮） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="@drawable/widget_preview_panel_neutral"
        android:orientation="vertical"
        android:padding="6dp">

    <!-- 第 1 大节 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="#172033"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:10"
                android:textColor="#56647B"
                android:textSize="8sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:50"
                android:textColor="#56647B"
                android:textSize="8sp" />
        </LinearLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="1dp"
            android:layout_weight="1"
            android:background="@drawable/widget_preview_cell"
            android:backgroundTint="#D8E4F8"
            android:padding="6dp"
            android:text="高等数学\n教五 301 · 张老师"
            android:textColor="#3A4A63"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 第 2 大节 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:textColor="#172033"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:10"
                android:textColor="#56647B"
                android:textSize="8sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11:50"
                android:textColor="#56647B"
                android:textSize="8sp" />
