<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 课表与上课提醒应用专属精确闹钟权限：Android 13+ 安装即自动授予，保证未进入应用也能准时上岛与按分钟刷新 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 小部件在开机后刷新一次，避免显示开机前的旧课表 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 上课提示以常驻通知承载（全设备），Android 13+ 需运行时授权 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Android 16+ 的「实况通知 / Live Updates」：申请把常驻通知提升为实时通知。
      非运行时权限，原生 Android 16 与澎湃 OS 3 均适用；能否提升由系统决定，
      未放行时通知按普通通知下发。
    -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application
        android:name=".BetterHrbustApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BetterHRBUST"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="true">

        <!-- singleTop：小部件点击复用已有任务并走 onNewIntent，避免重建整个界面 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.BetterHRBUST">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".widget.TimetableWidgetProvider" android:exported="false" android:label="@string/widget_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/><action android:name="android.intent.action.BOOT_COMPLETED"/><action android:name="android.intent.action.DATE_CHANGED"/><action android:name="android.intent.action.TIME_SET"/><action android:name="android.intent.action.TIMEZONE_CHANGED"/><action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/timetable_widget_info"/>
        </receiver>
        <service android:name=".widget.WidgetListService" android:exported="false" android:permission="android.permission.BIND_REMOTEVIEWS"/>
        <!-- ================= 桌面课表小部件（周视图 4×4） ================= -->
        <receiver
            android:name=".widget.TimetableWeekWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_week_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/timetable_week_widget_info" />
            <!--
              vivo 原子组件标识：仅在通过 vivo 原子组件平台审核后启用。
              未审核时声明 vivo_widget=true，OriginOS 会把它从「应用挂件」列表移出，
              改由「原子组件」库承载；该库只收录已审核组件，结果是无处可添加。
              审核通过后取消注释，vivoWidgetVersion 从 1 开始且只能升。
            <meta-data android:name="vivo_widget" android:value="true" />
            <meta-data android:name="vivoWidgetVersion" android:value="1" />
            <meta-data
                android:name="vivo.widget.description"
                android:resource="@string/widget_week_vivo_description" />
            -->
        </receiver>

        <!-- ================= 桌面课表小部件（日视图 2×4） ================= -->
        <receiver
            android:name=".widget.TimetableDayNarrowWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_day_narrow_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/timetable_day_narrow_widget_info" />
            <!--
              vivo 原子组件标识：仅在通过 vivo 原子组件平台审核后启用。
              未审核时声明 vivo_widget=true，OriginOS 会把它从「应用挂件」列表移出，
              改由「原子组件」库承载；该库只收录已审核组件，结果是无处可添加。
              审核通过后取消注释，vivoWidgetVersion 从 1 开始且只能升。
            <meta-data android:name="vivo_widget" android:value="true" />
            <meta-data android:name="vivoWidgetVersion" android:value="1" />
            <meta-data
                android:name="vivo.widget.description"
                android:resource="@string/widget_day_narrow_vivo_description" />
            -->
        </receiver>

        <!-- ================= 桌面课表小部件（日视图 4×4） ================= -->
        <receiver
            android:name=".widget.TimetableDayWideWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_day_wide_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/timetable_day_wide_widget_info" />
            <!--
              vivo 原子组件标识：仅在通过 vivo 原子组件平台审核后启用。
              未审核时声明 vivo_widget=true，OriginOS 会把它从「应用挂件」列表移出，
              改由「原子组件」库承载；该库只收录已审核组件，结果是无处可添加。
              审核通过后取消注释，vivoWidgetVersion 从 1 开始且只能升。
            <meta-data android:name="vivo_widget" android:value="true" />
            <meta-data android:name="vivoWidgetVersion" android:value="1" />
            <meta-data
                android:name="vivo.widget.description"
                android:resource="@string/widget_day_wide_vivo_description" />
            -->
        </receiver>

        <!--
          小部件刷新触发：跨天 / 手动改时间 / 时区变化 / 开机。
          这些均为系统受保护广播，exported=false 亦能收到，避免被其它应用触发无谓刷新。
        -->
        <receiver
            android:name=".widget.TimetableWidgetRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 上课提示（超级岛 / 实况通知）：课前 20 分钟窗口级前台服务，防后台冻结导致倒计时停走，上课即停 -->
        <service
            android:name=".core.notify.ClassReminderService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="课前 20 分钟在状态栏与超级岛实时刷新上课倒计时与教室，上课后立即结束服务" />
        </service>

        <!-- 上课提示闹钟与系统时间广播接收器 -->
        <receiver
            android:name=".core.notify.ClassReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.glassous.betterhrbust.action.CLASS_REMINDER_TICK" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
