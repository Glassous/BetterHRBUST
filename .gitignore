# ============================================================
# 哈理工教务在线 · 仓库忽略规则
# ============================================================

# ---------- 探测产物（含真实隐私数据，绝不入库）----------
# 这些目录里包含成绩单、学籍信息（身份证号 / 手机号 / 家庭住址）、
# 姓名与学号等敏感内容，以及登录会话 Cookie。
# 用 `output/*` 而非 `output/`，以便保留 .gitignore / .gitkeep 本身。
tools/probe/output/*
!tools/probe/output/.gitignore
!tools/probe/output/.gitkeep

# 探测过程中可能产生的临时目录
tools/probe/.smoke/
tools/probe/.tmp/

# config.json 由 config.example.json 复制而来，含教务密码，绝不能入库
tools/probe/config.json

# ---------- 依赖与构建产物 ----------
node_modules/
dist/
dist-ssr/
.vite/
*.local

# ---------- 服务端本地配置与构建产物 ----------
server/bin/
server/tmp/
server/.env
admin/.env
web/.env

# ---------- 容器化部署本地配置（含 JWT_SECRET，绝不能入库）----------
.env
!.env.example

# Tauri 桌面端：Rust 构建产物 / 权限 schema 生成物 / 打包输出
desktop-tauri/src-tauri/target/
desktop-tauri/src-tauri/gen/
desktop-tauri/release/
# 终端界面（Go）交叉编译产物，由 npm run build:tui 生成后打进安装目录
desktop-tauri/binaries/
# 全平台整合包脚本的临时组装目录
desktop-tauri/.tmp-all-platforms/
# CI 汇总 job 存放两个平台产物的中转目录
staging/

# ---------- 编辑器与 IDE ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- 操作系统 ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---------- 日志与临时文件 ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp

# 油猴脚本构建产物
web/dist-userscript/

# 海报导出产物
poster/out/

# ---------- Android 构建与本地配置 ----------
.gradle/
**/build/
build/
local.properties
**/local.properties
*.apk
*.aab
*.ap_
*.dex
*.class
captures/
.externalNativeBuild
.cxx
*.keystore
*.jks
*.hprof
*.iml

# ---------- AI 协作与智能体工作目录 ----------
.agents/
.gemini/
.claude/

__pycache__/
# Playwright CLI 快照与调试产物
.playwright-cli/
