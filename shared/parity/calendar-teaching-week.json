{
  "schemaVersion": 1,
  "id": "calendar-teaching-week",
  "kind": "teachingWeek",
  "description": "教学周换算：以 shared/school-calendar.json 为唯一来源，假期返回 null",
  "reference": [
    "web/src/utils/schoolCalendar.js",
    "desktop-tauri/src-tauri/src/cli/calendar.rs"
  ],
  "cases": [
    {
      "name": "2026 秋第 6 周",
      "clock": {"today": "2026-10-10"},
      "input": {"today": "2026-10-10"},
      "expect": [
        {"path": "week", "equals": 6},
        {"path": "teachingWeeks", "equals": 19},
        {"path": "semesterLabel", "equals": "2026 秋"}
      ]
    },
    {
      "name": "教学周最后一天仍是第 19 周",
      "input": {"today": "2027-01-10"},
      "expect": [
        {"path": "week", "equals": 19},
        {"path": "teachingWeeks", "equals": 19}
      ]
    },
    {
      "name": "超出教学周即假期",
      "input": {"today": "2027-01-11"},
      "expect": [
        {"path": "week", "null": true},
        {"path": "teachingWeeks", "equals": 19}
      ]
    },
    {
      "name": "2027 春第 1 周",
      "input": {"today": "2027-03-01"},
      "expect": [
        {"path": "week", "equals": 1},
        {"path": "semesterLabel", "equals": "2027 春"}
      ]
    },
    {
      "name": "2027 春第 19 周",
      "input": {"today": "2027-07-11"},
      "expect": [
        {"path": "week", "equals": 19}
      ]
    },
    {
      "name": "2027 春教学周结束后返回 null",
      "input": {"today": "2027-07-12"},
      "expect": [
        {"path": "week", "null": true}
      ]
    },
    {
      "name": "校历未收录的日期不猜测学期",
      "input": {"today": "2025-09-01"},
      "expect": [
        {"path": "week", "null": true},
        {"path": "semesterLabel", "null": true},
        {"path": "teachingWeeks", "equals": 20}
      ]
    }
  ]
}
